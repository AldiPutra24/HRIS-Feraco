# Local development — PostgreSQL on localhost (never production Supabase).
APP_ENV=development
DB_ENGINE=postgresql

# Backend (Django)
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL
DB_NAME=hris_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Dev storage bucket (isolated from production)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents-dev

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
