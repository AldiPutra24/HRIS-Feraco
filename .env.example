# === Django / Backend ===
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database engine: 'postgres' (Supabase/PostgreSQL) or 'sqlite' (local only)
DB_ENGINE=postgres

# === PostgreSQL (primary) ===
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# === Storage (service key backend-only) ===
URL=
SECRET_KEY=
STORAGE_BUCKET=employee-documents

# === CORS / CSRF (frontend origin) ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002

# === Frontend ===
# NEXT_PUBLIC_API_URL=http://localhost:8000
