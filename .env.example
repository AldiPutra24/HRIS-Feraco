# ============================================================
# HRIS Feraco — environment template
# Copy to `.env` for LOCAL development only.
# Production secrets come from server environment variables only.
# See `.env.development.example` and `.env.production.example`.
# ============================================================

# App environment: development | production
APP_ENV=development

# === Django / Backend ===
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database engine: 'sqlite' (tests / quick local) or empty (PostgreSQL via APP_ENV)
DB_ENGINE=

# === Local PostgreSQL (APP_ENV=development) ===
DB_NAME=hris_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# === Supabase PostgreSQL (APP_ENV=production only) ===
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.<ref>
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_HOST=db.<ref>.supabase.co
# SUPABASE_DB_PORT=5432

# === Supabase Storage (service key backend-only) ===
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# dev default: employee-documents-dev | prod default: employee-documents
SUPABASE_STORAGE_BUCKET=

# === CORS / CSRF (frontend origin) ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002

# === Frontend ===
# NEXT_PUBLIC_API_URL=http://localhost:8000
