# Production — Supabase PostgreSQL.
# Set these in the SERVER environment only; never commit real values.
APP_ENV=production

# Backend (Django)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=

# Supabase PostgreSQL (required)
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=db.<ref>.supabase.co
SUPABASE_DB_PORT=5432

# Supabase Storage (service key backend-only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=employee-documents

CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

NEXT_PUBLIC_API_URL=
